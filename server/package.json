{
  "name": "clipsync-server",
  "version": "0.0.1",
  "private": true,
  "description": "Zero-knowledge sync server for Clipboard Sync: stores and relays encrypted blobs only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
